# ============================================================
# Omnivex Academy — environment template
# Copy to .env and fill in real values.  NEVER commit the real .env.
# ============================================================

# --- Core ---------------------------------------------------
NODE_ENV=production
# Port the container publishes on the host (the app always listens on 3000
# inside the container). Change it only if 3000 is taken on this VPS.
PORT=3000
# Public URL of the app — the ROOT domain (no subdomain), used for
# better-auth, Paystack callbacks and webhook URLs.
APP_URL=https://omnivex-academy.xyz

# --- Auth ---------------------------------------------------
# Long random string (e.g. `openssl rand -base64 32`). If left empty a
# secret is generated once and persisted under data/.auth-secret.
BETTER_AUTH_SECRET=

# --- Admin bootstrap (first admin account) -------------------
ADMIN_EMAIL=admin@omnivex-academy.xyz
ADMIN_PASSWORD=

# --- Database + uploads --------------------------------------
# Defaults keep everything inside ./data (persisted, backed up, mounted).
# DATA_DIR=./data
# DATABASE_URL=./data/omnivex.db

# --- Email, OTP & broadcasts (Resend) ------------------------
RESEND_API_KEY=
RESEND_FROM_NAME=Omnivex Academy
RESEND_FROM_EMAIL=hello@omnivex-academy.xyz
# RESEND_WEBHOOK_SECRET=

# --- Payments (Paystack) -------------------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# MEMBERSHIP_PRICE_KOBO=500000

# --- Web push (optional) -------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@omnivex-academy.xyz

# --- Optional: automations run by ./deploy.sh ------------------
# Email for Let's Encrypt expiry notices (./deploy.sh tls).
# LETSENCRYPT_EMAIL=
# Cloudflare API token with Zone.DNS (Edit) + Zone.SSL and Certificates
# (Edit) for omnivex-academy.xyz. When set, deploy.sh creates/updates the
# proxied A record itself and keeps the zone SSL mode on Full (safe for every
# domain on the zone). The Worker front additionally needs: Account Settings
# (Read), Workers Scripts (Edit), Workers Routes (Edit).
# One-time Worker front: ./deploy.sh worker  (uses this token for everything:
# origin port, Worker upload, routes, DNS record and SSL mode).
# CLOUDFLARE_API_TOKEN=
#
# Proxy mode: auto (default) wires the web server already on port 80
# (nginx/Apache/Caddy, including a Caddy container) and falls back to the
# Cloudflare Worker front when that service cannot be wired safely;
# worker forces the Worker front (edge TLS, no origin cert, no port-80 fight).
# PROXY_MODE=auto
# Origin port published only in Worker mode (the Worker proxies to it).
# WORKER_ORIGIN_PORT=8443

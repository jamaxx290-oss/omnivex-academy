# ============================================================
# Omnivex Academy — environment template
# Copy to .env and fill in real values.  NEVER commit the real .env.
# ============================================================

# --- Core ---------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL of the app (your domain once pointed at this server)
APP_URL=http://localhost:3000

# --- Auth ---------------------------------------------------
# Long random string (e.g. `openssl rand -base64 32`). If left empty a
# secret is generated once and persisted under data/.auth-secret.
BETTER_AUTH_SECRET=

# --- Admin bootstrap (first admin account) -------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Database + uploads --------------------------------------
# Defaults keep everything inside ./data (persisted, backed up, mounted).
# DATA_DIR=./data
# DATABASE_URL=./data/omnivex.db

# --- Email, OTP & broadcasts (Resend) ------------------------
RESEND_API_KEY=
RESEND_FROM_NAME=Omnivex Academy
RESEND_FROM_EMAIL=hello@example.com
# RESEND_WEBHOOK_SECRET=

# --- Payments (Paystack) -------------------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# MEMBERSHIP_PRICE_KOBO=500000

# --- Web push (optional) -------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
